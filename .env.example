# =============================================================================
# BET62 — Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` na RAIZ do monorepo e preencha os valores.
#
#   cp .env.example .env
#
# Todos os valores marcados como [OBRIGATÓRIO] são exigidos para o servidor subir.
# Valores com [OPCIONAL] têm defaults seguros/conservadores e funcionam sem
# precisar ser definidos.
#
# Documentação baseada em:
#   - artifacts/api-server/src/lib/config.ts
#   - lib/db/drizzle.config.ts
#   - artifacts/api-server/src/middlewares/auth.ts (SESSION_SECRET hard-throw)
#   - artifacts/api-server/src/routes/admin.ts (ADMIN_* hard-throw)
#   - artifacts/api-server/src/lib/mailer.ts
# =============================================================================


# =============================================================================
# 1. PLATAFORMA / INFRAESTRUTURA
# =============================================================================

# [OBRIGATÓRIO] Runtime do Node.
#   - development = CORS aberto, stack traces em bets.ts; Express.serve estático desligado
#   - production = Railway/Replit. Sem CORS (mesmo-origin), SPA estático servido pelo Express
NODE_ENV=development

# [OPCIONAL] Porta HTTP do API Server. Default: 8080
PORT=8080

# [OPCIONAL] Alias da PORT (algumas docs referem-se a API_PORT.
# Se definido, sobrepõe PORT para o servidor HTTP (ver api/index.ts).
API_PORT=8080

# [OPCIONAL] Nível do logger pino. Default: info
# Valores: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# [OPCIONAL] URL pública do site, usada em callbacks de casino (SilentAPI /
# Palace) para montar redirect deeplinks pós-round. Default: Railway/Replit infere do host
# automaticamente; defina explicitamente em ambiente local se você expõe por domínio próprio.
PUBLIC_SITE_URL=https://seu-dominio.com

# [OPCIONAL] Deploy Railway injeta REPLIT_DOMAINS automaticamente se hospedado no Replit.
# Não precisa definir local.
# REPLIT_DOMAINS=

# [OPCIONAL] Vite (bet62 / mockup-sandbox). Default: /
BASE_PATH=/


# =============================================================================
# 2. BANCO DE DADOS — PostgreSQL
# =============================================================================

# [OBRIGATÓRIO] Connection string completa. Usada por:
#   - lib/db/src/index.ts          (conexão runtime)
#   - lib/db/drizzle.config.ts     (push / migrations)
# Formato: postgresql://usuario:senha@host:porta/banco?sslmode=...
# Exemplo Railway/Docker local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bet62?schema=public


# =============================================================================
# 3. CACHE / LOCK DISTRIBUÍDO — Redis
# =============================================================================

# [OPCIONAL] Se vazio: settlement cai para "single-instance mode",
#   rate-limit cai para memory-store (in-memory map), cache genérico (casino)
#   cai para LRU em memória. Defina em produção multi-instância!
# Formato: redis://user:senha@host:porta/dbnum
REDIS_URL=redis://127.0.0.1:6379


# =============================================================================
# 4. AUTENTICAÇÃO / SEGURANÇA
# =============================================================================

# [OBRIGATÓRIO] Segredo JWT de sessão. Usado por:
#   - middlewares/auth.ts       Bearer token (usuario normal)
#   - middlewares/adminAuth.ts    Admin Bearer token admin)
#   - routes/admin.ts          login admin)
#   - SESSION_SECRET
# NÃO COMPARTILHE, NÃO VERSIONE, NÃO USE valores fixos em produção.
# Gere um aleatório forte (ex: openssl rand -hex 32)
SESSION_SECRET=substitua-por-uma-string-aleatoria-longa-e-forte


# =============================================================================
# 5. USUÁRIO ADMIN (Backoffice)
# =============================================================================

# [OBRIGATÓRIO] Credenciais únicas do painel admin.
# São checadas em routes/admin.ts POST /admin/login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=substitua-por-senha-admin-forte
ADMIN_EMAIL=admin@seudominio.com


# =============================================================================
# 6. EMAIL (SMTP) — Nodemailer
# =============================================================================
# Usado por lib/mailer.ts:
#   - confirmação de depósito (sendDepositConfirmed)
#   - liquidação de aposta (sendBetSettled)
#   - outros e (saques, KYC, etc)

# [OPCIONAL] Se não configurado, envio de e-mail fica NO-OP (só loga).
SMTP_HOST=smtp.seu-smtp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [OPCIONAL] Remetente das mensagens. Default: noreply@bet62.com
SMTP_FROM=suporte@seudominio.com


# =============================================================================
# 7. PAGAMENTOS — Stripe
# =============================================================================

# [OBRIGATÓRIO p/ operar com cartão] Chave secreta Stripe (sk_live_... sk_test_...
STRIPE_SECRET_KEY=
# [OBRIGATÓRIO p/ operar com cartão] Chave publicável.
#   - Lido por payments.ts (retornada para o Stripe Elements) e exposta no frontend via
#   endpoints payments/public-key. Também mapeia VITE_STRIPE_PUBLISHABLE_KEY como fallback.
STRIPE_PUBLISHABLE_KEY=
# [OPCIONAL] Assinatura do webhook Stripe (Stripe CLI ou Dashboard).
# Necessário se você receber webhooks (ex: checkout.session.completed,
# payment_intent.succeeded) do dashboard Stripe.
STRIPE_WEBHOOK_SECRET=
# [OPCIONAL] Fallback para STRIPE_PUBLISHABLE_KEY no frontend (algumas builds Vite
# usam VITE_ prefix). Mesmo valor de STRIPE_PUBLISHABLE_KEY se estiver em dúvida.
VITE_STRIPE_PUBLISHABLE_KEY=

# [OPCIONAL] Segredo do webhook de payout (saques). Se vazio, não há validação de
# assinatura no endpoint POST /withdrawals/payout-webhook.
WITHDRAWAL_PAYOUT_WEBHOOK_SECRET=


# =============================================================================
# 8. PROVIDERS ESPORTIVOS
# =============================================================================
# GoalServe, SportMonks, StatPal, SportsAPI Pro, API-Football, SMYTDRYT, BetBY
# e bzzoiro foram todos removidos por decisão explícita do usuário — nenhum
# tem código real no repo hoje (confirmado 2026-09-18, não são só chaves
# vazias). Arquitetura atual, por decisão explícita de 2026-09-18:
#   - GOAL API (8.1) — fonte de DADOS de futebol (fixtures/live/eventos/
#     stats/lineups/H2H/standings). NÃO fornece odds.
#   - PropLine (8.2) — fonte de ODDS de futebol + dados E odds de todos os
#     outros esportes (tênis, basquete, baseball, hóquei, volleyball, MMA,
#     darts). Preços são a MÉDIA entre todos os bookmakers que precificaram
#     o mercado, não um único bookmaker preferido.
#   - api-tennis.com (8.3) — segunda fonte real de tênis, ao lado do
#     PropLine (não foi substituído, apenas ganhou um concorrente real —
#     chooseUpcomingProvider/chooseLiveProvider escolhem o melhor a cada
#     ciclo).
#   - PulseScore (8.4) — desativado (PULSESCORE_API_KEY forçado a "" em
#     config.ts), mantido só como kill-switch reversível.
# =============================================================================

# ----------------------------------------------------------------------
# 8.1 GOAL API (api.goal-api.com) — provedor dedicado de DADOS de FUTEBOL
# ----------------------------------------------------------------------
# Fixtures/eventos/stats/lineups/predictions/results pré-jogo e ao vivo,
# webhook de eventos críticos e WebSocket Data Collector (inerte até o
# plano permitir mais de 0 partidas simultâneas). Auth: Authorization:
# Bearer <chave>. Odds/live-odds desta API NÃO são usadas — futebol usa
# odds do PropLine (8.2).
GOAL_API_KEY=
# [OPCIONAL] Default: https://api.goal-api.com/v1
GOAL_API_BASE_URL=https://api.goal-api.com/v1
# [OPCIONAL] Default: wss://api.goal-api.com/ws
GOAL_API_WS_URL=wss://api.goal-api.com/ws
# Segredo do webhook (X-Goal-Signature) — sem isso o endpoint
# /api/webhooks/goal-api rejeita toda requisição.
GOAL_API_WEBHOOK_SECRET=
# [OPCIONAL] Limite de partidas simultâneas via WebSocket, conforme o plano
# (FREE=0, BASIC=5, PRO=20, ENTERPRISE=1000). Default: 0.
GOAL_API_MAX_WS_MATCHES=0
# [OPCIONAL] Não usado hoje (odds do GOAL API estão desativadas) — mantido
# só porque o código do client ainda referencia a constante. Default: 120000.
GOAL_API_ODDS_POLL_MS=120000
# [OPCIONAL] Idem, não usado hoje. Default: 40.
GOAL_API_MAX_ODDS_DELTA_PCT=40

# ----------------------------------------------------------------------
# 8.2 PropLine — ODDS de futebol + DADOS/ODDS de todos os outros esportes
# ----------------------------------------------------------------------
# Plano STREAMING $79/mês = 1.000.000 req/dia + 10 webhooks ativos.
# SDK oficial npm: propline. Compatível com the-odds-api (troca só a base URL).
PROPLINE_API_KEY=
# [OPCIONAL] Default: https://api.prop-line.com
PROPLINE_BASE_URL=https://api.prop-line.com
# [OPCIONAL] Default: v1
PROPLINE_API_VERSION=v1
# [OPCIONAL] Quais esportes ativar na ingestão do PropLine (virgula, default todos).
# Esportes válidos: baseball_mlb basketball_nba basketball_wnba hockey_nhl
#   football_nfl football_ncaaf soccer_* tennis mma_ufc golf cricket darts
#   tabletennis esports rugby afl cfl boxing
PROPLINE_ENABLED_SPORTS=baseball_mlb,basketball_nba,basketball_wnba,hockey_nhl,football_nfl,football_ncaaf,soccer_epl,soccer_la_liga,soccer_serie_a,soccer_bundesliga,soccer_ligue_1,soccer_mls,tennis,mma_ufc,darts
# [OPCIONAL] Bookmakers padrão para cross-book (default: TODOS — deixa sem
# draftkings,fanduel,pinnacle,betmgm,bovada,betrivers,unibet,novig,
# propetx,underdog,prizepicks,kalshi,polymarket)
#PROPLINE_DEFAULT_BOOKMAKERS=
# [OPCIONAL] Origem do WebSocket real de odds (futebol/tênis/basquete/
# hóquei/beisebol) — confirmado real 2026-09-19, plano Streaming (5
# conexões). Default: wss://ws.prop-line.com
PROPLINE_WS_URL=wss://ws.prop-line.com
# Secret do webhook HTTP push (line_movement/resolution/steam/
# market_suspended) — SÓ é devolvido uma vez, na resposta de criação do
# webhook (createHttpWebhook). Sem isto, toda entrega chega e é rejeitada
# com 401 (assinatura inválida) mesmo com a rota certa registada.
PROPLINE_HTTP_WEBHOOK_SECRET=

# ----------------------------------------------------------------------
# 8.3 api-tennis.com — segunda fonte real de TÊNIS (ao lado do PropLine)
# ----------------------------------------------------------------------
# Fixtures/livescore (com pointbypoint/scores/statistics embutidos), odds,
# H2H, standings, players e draw. Sem webhook/WebSocket — só polling REST.
# Auth: APIkey como query param (não header).
TENNIS_API_KEY=
# [OPCIONAL] Default: https://api.api-tennis.com/tennis/
TENNIS_API_BASE_URL=https://api.api-tennis.com/tennis/

# ----------------------------------------------------------------------
# 8.4 PulseScore (api.pulsescore.net) — DESATIVADO, kill-switch reversível
# ----------------------------------------------------------------------
# PULSESCORE_API_KEY é forçado a "" em config.ts independente do valor
# real aqui (deixar vazio ou preencher não muda nada em produção) — a
# reativação exige apagar essa linha em config.ts, não só preencher a
# chave. Auth: header x-secret: <chave> (não Bearer nem query param).
PULSESCORE_API_KEY=
# [OPCIONAL] Default: https://api.pulsescore.net
PULSESCORE_BASE_URL=https://api.pulsescore.net
# [OPCIONAL] Intervalo mínimo (ms) entre chamadas — confirmado real em
# produção: o plano PRO permite 1 requisição/segundo por bookmaker (HTTP
# 429 acima disso). Default: 1100 (pouca folga sobre 1000ms).
PULSESCORE_MIN_REQUEST_INTERVAL_MS=1100


# =============================================================================
# 9. CASINO (2 agregadores simultâneos: SilentAPI + Palace Casino)
# =============================================================================

# ----------------------------------------------------------------------
# 9.1 SilentAPI (legado / ativo)
# ----------------------------------------------------------------------
# [OPCIONAL] Default: https://silentapi.org/api
SILENTAPI_BASE_URL=https://silentapi.org/api
SILENTAPI_AUTH_TOKEN=
# Segredo HMAC-SHA256 do callback /api/casino/callback.
SILENTAPI_CALLBACK_SECRET=

# ----------------------------------------------------------------------
# 9.2 Palace Casino (Gold Slot Palace) — substituto planejado
# ----------------------------------------------------------------------
# Apenas wallet + listagem wired por enquanto. Launch endpoint + callback
# scheme ainda não documentados; catalogo vazio até PALACE_CASINO_API_TOKEN.
# [OPCIONAL] Default: https://agent.goldslotpalase.com/v4
PALACE_CASINO_BASE_URL=https://agent.goldslotpalase.com/v4
PALACE_CASINO_API_TOKEN=
# Valor que Palace envia no header "Callback-Token" em wallet callbacks.
PALACE_CASINO_CALLBACK_TOKEN=


# =============================================================================
# 10. INTELIGÊNCIA ARTIFICIAL OPERACIONAL (Agentes IA)
# =============================================================================
# Documentado em: artifacts/api-server/src/lib/aiAgents/client.ts e
#              artifacts/api-server/src/routes/adminAiAgents.ts
#
# Endpoint compatível com Chat Completions (OpenRouter por padrão, mas funciona com
# Groq / Together.ai / Ollama / vLLM self-hosted etc).

# 10.1 Gerador AI de copy de banners (POST /admin/casino/banners/ai-generate).
#      Usa Anthropic diretamente. Fallback para templates determinísticos se vazio.
ANTHROPIC_API_KEY=

# 10.2 Agentes operacionais AI (Risk / Odds / Settlement / Fraud / etc.)
#     Por padrão aponta para OpenRouter (modelos open source gratuitos Llama).
AI_AGENTS_API_KEY=
# [OPCIONAL] Default: https://openrouter.ai/api/v1
# Troque por Ollama local: http://localhost:11434/v1
AI_AGENTS_BASE_URL=https://openrouter.ai/api/v1
# [OPCIONAL] Default: meta-llama/llama-3.3-70b-instruct:free
# OpenRouter cota free: 20 req/min + 50 req/dia sem créditos.
# Recomendado produção: comprar créditos OpenRouter ou endpoint próprio.
AI_AGENTS_MODEL=meta-llama/llama-3.3-70b-instruct:free


# =============================================================================
# 11. WORKER DE LIQUIDAÇÃO (settlement worker)
# =============================================================================
# Todos opcionais, ms valores defaults.
# -----------------------------------------------------------------------------

# [OPCIONAL] Intervalo do polling worker liquidação. Default: 15000ms (15s)
SETTLEMENT_INTERVAL_MS=15000

# [OPCIONAL] Atraso antes do primeiro ciclo após startup. Default: 5000ms (5s)
SETTLEMENT_INITIAL_DELAY_MS=5000

# [OPCIONAL] Intervalo do catch-up de bets pendentes históricos.
# Default: 60000 (1 min)
SETTLEMENT_CATCHUP_INTERVAL_MS=60000

# [OPCIONAL] Enable BullMQ queue + Redis praçao.
# Se REDIS_URL estiver setado o settlementQueue usa Redis; senão memoria.

# =============================================================================
# 12. CRON AUTOMÁTICO DOS AGENTES IA
# =============================================================================
# Por defeito ligado se AI_AGENTS_API_KEY estiver definida. Desliga com false.
# Todos os intervalos estão em milissegundos (ms). Ex.: 6h = 6*60*60*1000 = 21600000

# AI_CRON_ENABLED=false                                 # desligar completamente

# AI_CRON_ODDS_INTERVAL_MS=1800000                        # (30m) feeds instáveis
# AI_CRON_LIVEMATCH_INTERVAL_MS=900000                   # (15m) jogos presos
# AI_CRON_RISK_INTERVAL_MS=3600000                       # (1h)  concentração exposição
# AI_CRON_TICKETSETTLE_INTERVAL_MS=3600000               # (1h)  tickets stuck (auto-void)
# AI_CRON_SETTLEMENT_INTERVAL_MS=10800000                # (3h)  revisão manual
# AI_CRON_SUPPORT_INTERVAL_MS=7200000                    # (2h)  rejeições → respostas
# AI_CRON_PAYMENTS_INTERVAL_MS=21600000                  # (6h)  saques pending
# AI_CRON_COMPLIANCE_INTERVAL_MS=21600000                # (6h)  KYC pending
# AI_CRON_PREMATCH_INTERVAL_MS=21600000                  # (6h)  gaps mercados/nomes
# AI_CRON_FRAUD_INTERVAL_MS=43200000                     # (12h) NIF/IBAN duplicados
# AI_CRON_ORCHESTRATOR_INTERVAL_MS=28800000              # (8h ~3x/dia resumo execut)
