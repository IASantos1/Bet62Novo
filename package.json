{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:settlement": "pnpm --filter @workspace/api-server test:settlement",
    "test:core": "pnpm --filter @workspace/api-server test:core",
    "test": "pnpm run test:settlement && pnpm run test:core",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "betby:debug-feed": "tsx artifacts/api-server/src/scripts/betbyDebugFeed.ts",
    "settlement:coverage": "pnpm --filter @workspace/scripts settlement:coverage"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rollup/rollup-win32-x64-msvc": "4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-zod": "^0.8.3",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "pg": "^8.20.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "zod": "catalog:"
  }
}
