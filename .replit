modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/bet62: web"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/bet62: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && PORT=5173 BASE_PATH=/ pnpm --filter @workspace/bet62 run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAIL = "suportebet62@gmail.com"
ADMIN_USERNAME = "Israel"
NODE_ENV = "development"
SMTP_FROM = "suportebet62@gmail.com"
SMTP_PORT = "587"
VITE_STRIPE_PUBLISHABLE_KEY = "pk_live_placeholder"
# ── Kill-switches providers esportivos (rollback 1 clique) ────────────────
# GoalServe = fornecedor primário ativo por defeito. Desligar = volta SportMonks/PulseScore.
ENABLE_GOALSERVE = "true"
ENABLE_SPORTMONKS = "false"
ENABLE_PULSESCORE = "false"
# GoalServe API key — NÃO COLOCAR valor real aqui; defina no painel Replit userenv privado
# (este campo shared é versionado e visível no fork). Deixe vazio em código commitado.
GOALSERVE_API_KEY = ""
# GoalServe base URLs (opcionais; já defaults seguros em config.ts; só descomente se sobrescrever)
# GOALSERVE_BASE_URL = "https://www.goalserve.com/getfeed"
# GOALSERVE_LIVESCORE_BASE = "https://livescore.goalserve.com/api/v1"
# GOALSERVE_ODDSSETTLE_BASE = "http://oddsfeed.goalserve.com/api/v1"
