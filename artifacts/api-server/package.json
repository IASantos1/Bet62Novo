{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./dev.cjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:settlement": "tsx --test src/tests/settlement.spec.ts",
    "test:core": "tsx --test src/tests/core.spec.ts",
    "test:pulsescore": "tsx --test src/tests/pulsescore.spec.ts",
    "seed:casino": "tsx src/scripts/seedCasinoGames.ts",
    "seed:palace-casino": "tsx src/scripts/seedPalaceCasinoGames.ts",
    "seed:featured-banners": "tsx src/scripts/seedFeaturedCasinoBanners.ts",
    "betby:debug-feed": "tsx src/scripts/betbyDebugFeed.ts",
