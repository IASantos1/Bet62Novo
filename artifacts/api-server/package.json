    "express": "^5",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pino": "^9",
    "pino-http": "^10",
    "stripe": "^22.2.0",
    "ws": "^8.20.0"
